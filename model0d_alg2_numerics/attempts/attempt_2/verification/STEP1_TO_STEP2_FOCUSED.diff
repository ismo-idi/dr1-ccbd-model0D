+        "R1_crosscheck_abs": residual["R1_crosscheck_abs"],
+        "R2_crosscheck_abs": residual["R2_crosscheck_abs"],
+    }
+    ok = residual["R1_crosscheck_abs"] <= lim1 and residual["R2_crosscheck_abs"] <= lim2
+    return bool(ok), details
