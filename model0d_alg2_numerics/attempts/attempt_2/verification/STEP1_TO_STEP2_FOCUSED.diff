+def test_stationary_exact_lift_is_feasible_for_both_local_domains_and_a1():
+    cfg = load_config(ROOT / 'configs' / 'baseline_2uav_0obs.json')
+    ops = assemble_tcc(cfg)
+    l1 = build_local_nlp(1, cfg, ops)
