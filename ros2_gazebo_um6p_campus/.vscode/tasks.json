{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Check prerequisites",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/setup.sh",
        "--plan"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/build.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Campus: launch paused",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/launch_environment.sh",
        "gui"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Demo 1: launch paused",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/launch_demo.sh",
        "1",
        "gui"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Demo 2: launch paused",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/launch_demo.sh",
        "2",
        "gui"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Demo: start",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/demo_control.sh",
        "start"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Demo: pause",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/demo_control.sh",
        "pause"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Verify campus headless",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/verify.sh",
        "headless"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
